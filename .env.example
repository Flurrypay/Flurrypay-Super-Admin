# Copy to .env.local and adjust. Never commit real values.
# `.env.production` holds the committed defaults used by production builds.

# Base URL of the backend API as reached from the Next.js server.
# Live: https://api.flurrypay.io
API_URL=https://api.flurrypay.io

# Base URL of the backend API as reached from the browser. Public — inlined into the client bundle.
# Live: https://api.flurrypay.io
NEXT_PUBLIC_API_URL=https://api.flurrypay.io

# "true" serves built-in sample data with no API and no sign-in. Defaults to "true"
# under `next dev`, so point a dev server at the live API by setting it to "false".
NEXT_PUBLIC_PREVIEW_MODE=false

# Server log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Set to "true" only for builds where runtime variables are injected later (e.g. container images).
# SKIP_ENV_VALIDATION=true
